---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';

import founderPhoto from '../assets/images/founder-smiling.jpg';
import peaksFramework from '../assets/images/peaks-framework.png';

const values = [
  {
    icon: 'peak',
    title: 'Performance, sustained',
    text: 'Peak performance that costs you your energy is not peak performance. We build rhythms that last.',
  },
  {
    icon: 'coaching',
    title: 'Science, made practical',
    text: 'Human performance science only matters when it becomes a tool you can use in the room.',
  },
  {
    icon: 'training',
    title: 'Alignment over acting',
    text: 'Presence is not a performance. We help leaders align who they are with how they show up.',
  },
  {
    icon: 'journeys',
    title: 'Partnership, not programmes',
    text: 'We design around your context and outcomes — and stay with you while change takes hold.',
  },
] as const;
---

<BaseLayout
  title="About | Lead At Your Peak"
  description="Lead At Your Peak helps leaders and teams elevate how they show up, communicate, and perform under pressure — through human performance science and the P.E.A.K.S.™ and A.L.I.G.N.™ frameworks."
>
  <Header slot="header" />

  <main>
    <!-- Hero -->
    <Section bg="white">
      <Container class="max-w-3xl text-center">
        <p class="eyebrow">About us</p>
        <h1 class="mt-4 text-4xl md:text-5xl">Guiding Leaders To Leading At Their Peak</h1>
        <div class="mt-6 flex justify-center"><PeakAccent /></div>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">
          Helping leaders and teams elevate how they show up, communicate, and perform under
          pressure.
        </p>
      </Container>
    </Section>

    <!-- Founder story -->
    <Section bg="cream">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.2fr]">
          <FadeIn class="mx-auto w-full max-w-md lg:max-w-none">
            <div class="relative">
              <Image
                src={founderPhoto}
                alt="Karolina Gwinner, founder of Lead At Your Peak"
                class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl shadow-navy-800/15"
                widths={[480, 768, 1024]}
                sizes="(min-width: 1024px) 480px, 90vw"
              />
              <PeakAccent variant="underline" class="absolute -bottom-5 left-8 h-4 w-32" />
            </div>
          </FadeIn>
          <FadeIn delay={150}>
            <p class="eyebrow">Meet the founder</p>
            <h2 class="mt-3 text-3xl md:text-4xl">Karolina Gwinner</h2>
            <p class="mt-5 max-w-xl leading-relaxed text-ink/80">
              Karolina works with senior leaders and teams in high-pressure environments, turning
              insights from human performance science into practical tools that shift how people
              lead, communicate, and perform when it matters most.
            </p>
            <p class="mt-4 max-w-xl leading-relaxed text-ink/80">
              <!-- TODO: full founder story — career background, what led to founding Lead At Your Peak, personal angle -->
              <span class="italic text-ink/50">TODO: Full founder story to be supplied.</span>
            </p>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Mission & values -->
    <Section bg="navy" class="relative overflow-hidden">
      <PeakAccent variant="watermark" class="absolute -left-10 bottom-0 h-64 w-auto opacity-20" />
      <Container class="relative">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow eyebrow--on-dark">Our mission</p>
          <h2 class="mt-3 text-3xl md:text-4xl">
            Lead with presence. Influence with impact. Perform at your peak.
          </h2>
          <p class="mt-5 leading-relaxed text-white/80">
            We help leaders and teams elevate how they show up, communicate, and perform under
            pressure — so success doesn't have to come at the cost of energy, authenticity, or
            impact.
          </p>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            values.map((value, index) => (
              <FadeIn delay={index * 100}>
                <Card class="h-full bg-white/95">
                  <Icon name={value.icon} class="h-6 w-6 text-gold-600" />
                  <h3 class="mt-4 text-base">{value.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink/70">{value.text}</p>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- Why this work matters + frameworks -->
    <Section bg="white">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <FadeIn>
            <p class="eyebrow">Why this work matters</p>
            <h2 class="mt-3 text-3xl md:text-4xl">Pressure isn't going anywhere. Burnout doesn't have to be the price.</h2>
            <p class="mt-5 max-w-xl leading-relaxed text-ink/80">
              The leaders we work with are talented, trusted, and ambitious — and many are quietly
              paying for their success with their energy, their confidence, or their sense of self.
              We believe there's a better way to be excellent.
            </p>
            <p class="mt-4 max-w-xl leading-relaxed text-ink/80">
              The P.E.A.K.S.&trade; framework helps leaders move from running on fumes to performing
              at their peak — building the energy, focus, resilience, and sustainable rhythm that
              long-term performance demands. The A.L.I.G.N.&trade; framework helps leaders elevate
              their visibility, gravitas, credibility, and impact by aligning who they are with how
              they show up.
            </p>
          </FadeIn>
          <FadeIn delay={150} class="mx-auto w-full max-w-lg">
            <Image
              src={peaksFramework}
              alt="The P.E.A.K.S. framework for sustainable peak performance"
              class="w-full rounded-2xl shadow-xl shadow-navy-800/15"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 520px, 90vw"
            />
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Credentials -->
    <Section bg="beige">
      <Container>
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow">Credentials &amp; experience</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Grounded in practice, backed by training</h2>
        </div>
        <div class="mx-auto mt-10 max-w-2xl rounded-2xl border-2 border-dashed border-navy-800/20 bg-white/60 p-10 text-center">
          <!-- TODO: real credentials, certifications, client experience highlights — never invented -->
          <p class="text-sm text-ink/60">
            TODO: Credentials, certifications, and experience highlights to be supplied.
          </p>
        </div>
      </Container>
    </Section>

    <!-- CTA -->
    <Section bg="navy" class="text-center">
      <Container>
        <h2 class="text-3xl md:text-4xl">Ready to lead at your peak?</h2>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/80">
          Let's talk about where you or your organisation want to climb next.
        </p>
        <div class="mt-8">
          <Button href="/contact">Work With Us</Button>
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
