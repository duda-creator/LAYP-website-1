---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';

import founderQuotePhoto from '../assets/images/KarolinaGwinner-76.jpg';
import purposePhoto from '../assets/images/purpose-power-pose.jpg';
import futureProofingPhoto from '../assets/images/Future proofing leaders.jpg';

const gaps = [
  {
    title: 'Knowing versus being able to do it when it matters',
    text: "Leadership development offers us an abundance of models, frameworks and strategies. But knowing what good leadership looks like and being able to embody it in a difficult conversation, a boardroom, a crisis or an exhausting week are two very different things. I became obsessed with closing that gap: the space between knowing and consistently being able to perform under pressure.",
  },
  {
    title: 'Developing leadership skills but overlooking the habits that drive human behaviours',
    text: 'A lot of programmes and investment goes into teaching leaders how to communicate, influence, delegate or coach, yet often pay far less attention to the human habits that drive adoption of new skills — how they manage their attention and energy, emotional regulation, and the ability to think clearly under pressure. But when those foundations are compromised, even the best leadership tools become much harder to access.',
  },
  {
    title: 'Leadership development often ends when the workshop ends',
    text: "I also saw how easily powerful insights disappeared once leaders returned to full calendars, competing priorities and everyday pressure. Enthusiasm evaporated quickly and got replaced by a daily grind. The issue wasn't a lack of intelligence or motivation. The challenge was turning insight into behaviour, and behaviour into a habit that is sustainable. My work aims at bridging that gap between learning about leadership and actually living it long after the programme is over.",
  },
] as const;

const expertiseMetrics = [
  {
    label: 'Facilitation',
    value: '15+',
    description: 'Years facilitating leadership development programmes',
  },
  {
    label: 'Programme Design',
    value: '10+',
    description: 'Years designing leadership development programmes',
  },
  {
    label: 'Coaching',
    value: '5+',
    description: 'Years of executive coaching experience',
  },
  {
    label: 'Newsletter',
    value: '1000+',
    description: 'Subscribers to Leaders’ Watercooler newsletter',
  },
] as const;

const professionalCredentials = [
  {
    label: '2025 | Certified Partner',
    title: 'Miki Island High-Performance Simulation',
    provider: 'Aeqlia',
  },
  {
    label: '2023 | Certification',
    title: 'Creating Leadership Development Programs',
    provider: 'Association for Talent Development (ATD)',
  },
  {
    label: '2021 | Certification',
    title: 'Brain-Based Coaching',
    provider: 'NeuroLeadership Institute',
  },
  {
    label: '2018 | Facilitator Training',
    title: 'Corporate Athlete® Performance Course',
    provider: 'Johnson & Johnson Human Performance Institute',
  },
] as const;

const recognitionContributions = [
  {
    icon: 'award',
    title: 'LinkedIn Top Voice',
    description: 'Recognised for thought leadership (2024)',
  },
  {
    icon: 'book',
    title: 'Published Co-Author',
    description:
      'Breakthrough: Secrets of Growth, Happiness and Bouncebacks from Women Around the World (2018)',
  },
  {
    icon: 'microphone',
    title: 'KeyNote Women Speakers',
    description: 'Speaker Training Co-Lead (2020–2025)',
  },
  {
    icon: 'users',
    title: 'Women Leaders Institute',
    description: 'Former Knowledge Partner (2019–2023)',
  },
] as const;
---

<BaseLayout
  title="Meet the Founder | Lead At Your Peak"
  description="Karolina Gwinner is a speaker, facilitator and executive coach who equips leaders, senior executives, and teams across APAC to elevate presence, influence, and performance."
>
  <Header slot="header" />

  <main>
    <!-- Hero: photo with quote overlay -->
    <section class="relative flex h-[calc(100svh-4rem)] max-h-[56rem] min-h-[34rem] items-center bg-navy-950 md:h-[calc(100svh-5rem)]">
      <Image
        src={founderQuotePhoto}
        alt="Karolina Gwinner"
        class="absolute inset-0 h-full w-full object-cover object-[30%_10%] sm:object-[50%_20%]"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/15 via-navy-900/55 to-navy-900/65"></div>
      <Container class="relative py-24 text-white md:py-32">
        <div class="max-w-2xl md:ml-auto md:max-w-xl lg:max-w-2xl">
          <p class="eyebrow eyebrow--on-dark">Meet the founder</p>
          <h1 class="mt-4 text-3xl leading-tight sm:text-4xl md:text-5xl">
            When Pressure Rises, Your Strength Can Become Your Liability
          </h1>
          <PeakAccent class="mt-6" />
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
            Drive can become intensity. High standards can become control. Responsibility can become
            overextension.
            <strong class="mt-2 block">Great leadership requires calibration.</strong>
          </p>
        </div>
      </Container>
    </section>

    <!-- What Shaped My View of Peak Leadership -->
    <Section bg="white">
      <Container>
        <div class="mx-auto grid max-w-3xl items-center gap-12 lg:max-w-none lg:grid-cols-[1.2fr_1fr] lg:gap-16">
          <FadeIn>
            <p class="eyebrow">Leadership is revealed under pressure</p>
            <h2 class="mt-3 text-3xl md:text-4xl">
              What Shaped My View of Peak Leadership
            </h2>
            <p class="mt-6 leading-relaxed text-ink/80">
              Over the years, working with leaders across industries and cultures, I've experienced
              two very different kinds of leadership.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              The difference became most apparent under pressure. When deadlines were slipping,
              targets were out of reach or uncertainty filled the room.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              With some leaders, I felt we could handle whatever came our way. They brought calm
              and clarity, trusted me and gave me the confidence to step up.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              Others had the opposite effect. When pressure mounted, so did the tension. I&nbsp;found
              myself second-guessing, holding back and feeling smaller.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              <strong>Same person. Same capabilities. Yet I showed up very differently.</strong>
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              I've since observed the same pattern in my work with clients: capable, experienced leaders
              whose presence and performance can shift dramatically depending on the leadership around them.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              It taught me something important.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              The most impactful leaders weren't necessarily the ones with the greatest expertise,
              strongest work ethic or most impressive titles.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              <strong>They were the ones who could stay clear, grounded and influential under pressure,
              and bring out the best in others.</strong>
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              That's how I see peak leadership. <strong>Not as performing at maximum intensity,
              but as accessing your best when it matters most, while helping others do the same.</strong>
            </p>
          </FadeIn>
          <FadeIn delay={150} class="mx-auto w-full max-w-lg">
            <Image
              src={purposePhoto}
              alt="Karolina Gwinner in a purple blazer beside a Purpose Power display"
              class="h-auto w-full rounded-2xl shadow-xl shadow-navy-800/15"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1200px) 488px, (min-width: 1024px) 40vw, (min-width: 640px) 512px, 90vw"
              loading="lazy"
            />
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Quote callout -->
    <Section bg="navy" class="relative overflow-hidden">
      <PeakAccent variant="watermark" class="absolute -right-10 bottom-0 h-64 w-auto opacity-20" />
      <Container class="relative max-w-2xl text-center">
        <p class="font-heading text-2xl italic leading-snug text-white md:text-3xl">
          &ldquo;Pressure doesn't build your leadership. It reveals it.&rdquo;
        </p>
        <p class="mx-auto mt-5 max-w-xl leading-relaxed text-white/80">
          When the stakes rise, your habits, patterns and ability to regulate yourself become
          impossible to hide.
        </p>
      </Container>
    </Section>


    <!-- What I saw missing -->
    <Section bg="cream" class="hidden">
      <Container>
        <div class="max-w-2xl">
          <p class="eyebrow">A different approach</p>
          <h2 class="mt-3 text-3xl md:text-4xl">
            What I saw missing in traditional leadership development
          </h2>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {
            gaps.map((gap, index) => (
              <FadeIn delay={index * 100}>
                <Card class="h-full">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-navy-800/5 font-heading text-lg font-semibold text-gold-600">
                    {index + 1}
                  </span>
                  <h3 class="mt-4 text-base">{gap.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink/70">{gap.text}</p>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- Why I built Lead At Your Peak -->
    <Section bg="white">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <FadeIn class="lg:order-2">
            <p class="eyebrow">Why I built Lead At Your Peak</p>
            <h2 class="mt-3 text-3xl md:text-4xl">
              Beyond Techniques: A Framework for Lasting Growth
            </h2>
            <p class="mt-5 leading-relaxed text-ink/80">
              After years of working with ambitious leaders and exploring research on leadership
              and peak performance, I realised that even the best techniques rarely create lasting change
              without a solid foundation.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              That insight inspired me to develop an integrated, research-informed approach that helps leaders recognise and shift the patterns shaping how they think, communicate, and influence under pressure.
            </p>
            <p class="mt-4 leading-relaxed text-ink/80">
              <strong>Lead at Your Peak was born from this vision:</strong> to help leaders build strong
              inner foundations, lead with intention and perform at their best, even when the stakes
              are high.
            </p>
          </FadeIn>
          <FadeIn delay={150} class="mx-auto w-full max-w-lg lg:order-1">
            <Image
              src={futureProofingPhoto}
              alt="Future proofing leaders"
              class="w-full rounded-2xl shadow-xl shadow-navy-800/15"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 520px, 90vw"
            />
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Background and expertise -->
    <Section bg="cream" id="background-and-expertise">
      <Container>
        <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] xl:gap-12">
          <FadeIn>
            <p class="eyebrow">Background and Expertise</p>
            <h2 class="mt-5 text-3xl leading-tight md:text-4xl">
              Bringing Research and Experience Together
            </h2>
            <div class="mt-7 space-y-5 leading-relaxed text-ink/85">
              <p>
                I'm a speaker, facilitator and executive coach who helps leaders and teams lead at
                their peak and achieve exceptional results.
              </p>
              <p>
                Drawing on over a decade of work with Fortune 500 companies, I design and deliver
                results-oriented learning solutions that strengthen leadership capabilities and
                translate learning into meaningful business impact.
              </p>
              <p>
                My approach combines real-world corporate experience, research-informed frameworks
                and practical, experiential learning methods.
              </p>
            </div>
            <div class="mt-8 border-t border-gold-600/50 pt-6">
              <h3 class="eyebrow">Corporate Roots</h3>
              <p class="mt-4 leading-relaxed text-ink/85">
                My corporate background spans financial services, technology and recruitment. It gives
                me a firsthand understanding of the pace, complexity and pressures that leaders
                navigate every day.
              </p>
              <ul class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-heading text-base font-bold text-ink">
                <li>Merrill Lynch</li>
                <li aria-hidden="true" class="text-gold-600">&middot;</li>
                <li>BNY Mellon</li>
                <li aria-hidden="true" class="text-gold-600">&middot;</li>
                <li>Hewlett-Packard</li>
              </ul>
            </div>
          </FadeIn>
          <FadeIn delay={150}>
            <dl class="grid gap-5 sm:grid-cols-2">
              {
                expertiseMetrics.map((metric) => (
                  <div class="expertise-card relative isolate min-w-0 overflow-hidden rounded-2xl p-6 pb-16 text-white shadow-sm ring-1 ring-white/10 sm:min-h-72 lg:min-h-80 lg:pb-20">
                    <dt class="relative z-10 font-heading text-xs font-semibold uppercase leading-relaxed tracking-[0.18em] text-[#ffda62] sm:text-sm">
                      {metric.label}
                    </dt>
                    <dd>
                      <span class="relative z-10 mt-5 block font-heading text-[clamp(3.5rem,5.5vw,4.5rem)] font-bold leading-none tracking-tight text-[#ffda62]">
                        {metric.value}
                      </span>
                      <p class="relative z-10 mt-3 text-lg leading-snug text-white/95 xl:text-xl">
                        {metric.description}
                      </p>
                      <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-24 w-full" viewBox="0 0 360 130" preserveAspectRatio="none" fill="none" aria-hidden="true">
                        <path d="M0 70C85 20 130 120 225 65C280 35 310 0 360 0V130H0Z" fill="#3f6593" fill-opacity="0.3" />
                        <path d="M0 125C100 60 155 100 245 65C295 45 325 50 360 75V130H0Z" fill="#0d2138" fill-opacity="0.5" />
                      </svg>
                      <PeakAccent class="absolute bottom-6 right-6 h-6" />
                    </dd>
                  </div>
                ))
              }
            </dl>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Professional credentials -->
    <Section bg="navy" id="professional-credentials">
      <Container>
        <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] xl:gap-12">
          <FadeIn>
            <p class="eyebrow eyebrow--on-dark">Professional Credentials</p>
            <h2 class="mt-4 max-w-sm text-3xl leading-tight text-white md:text-4xl">
              Credibility Built on Continuous Learning
            </h2>
            <p class="mt-5 max-w-sm leading-relaxed text-navy-100">
              My professional credentials reflect a commitment to growth and staying at the forefront of leadership development.
            </p>
          </FadeIn>
          <FadeIn delay={150}>
            <ol class="relative space-y-8 before:absolute before:bottom-0 before:left-0 before:top-2.5 before:w-px before:bg-gold-200/30" aria-label="Professional credentials">
              {
                professionalCredentials.map((credential) => (
                  <li class="relative pl-7 sm:pl-8">
                    <span aria-hidden="true" class="absolute -left-1 top-1.5 h-2 w-2 rounded-full bg-gold-400"></span>
                    <p class="font-heading text-xs font-semibold uppercase leading-relaxed tracking-[0.15em] text-gold-400">
                      {credential.label}
                    </p>
                    <h3 class="mt-1 text-lg leading-snug text-white">{credential.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-navy-100">{credential.provider}</p>
                  </li>
                ))
              }
            </ol>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- Recognition and contributions -->
    <Section bg="cream" id="recognition-and-contributions">
      <Container>
        <FadeIn>
          <p class="eyebrow">Recognition and Contributions</p>
          <h2 class="mt-5 text-3xl leading-tight md:text-4xl">
            Committed to Professional Excellence
          </h2>
          <p class="mt-5 leading-relaxed text-ink/75 md:text-lg">
            Alongside my work with clients, I share ideas and contribute to communities advancing
            leadership practice.
          </p>
        </FadeIn>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {
            recognitionContributions.map((contribution, index) => (
              <FadeIn delay={index * 75} class="h-full">
                <article class="flex h-full items-start gap-5 rounded-2xl bg-white p-6 lg:gap-6 lg:p-8">
                  <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-navy-800 text-[#ffda62] sm:h-16 sm:w-16">
                    <Icon name={contribution.icon} class="h-7 w-7 sm:h-8 sm:w-8" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-xl leading-snug">{contribution.title}</h3>
                    <p class="mt-3 leading-relaxed text-ink/85">{contribution.description}</p>
                  </div>
                </article>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- CTA -->
    <Section bg="navy" class="text-center">
      <Container>
        <h2 class="text-3xl md:text-4xl">Ready to find out what's possible for you?</h2>
        <div class="mt-8">
          <Button href="https://zcal.co/karolinagwinner" variant="gold" target="_blank" rel="noopener noreferrer">
            Book A Discovery Call
          </Button>
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .expertise-card {
    background: radial-gradient(ellipse at top left, #213f69, #142e52 65%, #102646);
  }
</style>
