---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';

import heroPhoto from '../assets/images/hero-session.jpg';
import founderPhoto from '../assets/images/founder-smiling.jpg';
import purposePhoto from '../assets/images/purpose-power-pose.jpg';
import newsletterPhoto from '../assets/images/Newsletter group of leaders smiling.jpg';

const services = [
  {
    icon: 'training',
    title: 'Leadership Development Training',
    description:
      'Practical, science-backed programmes that shift how leaders and teams communicate, decide, and deliver under pressure.',
    href: '/services#leadership-development-training',
  },
  {
    icon: 'coaching',
    title: 'Executive Coaching',
    description:
      'One-to-one partnership for senior leaders ready to sharpen their presence, influence, and impact where it matters most.',
    href: '/services#executive-coaching',
  },
  {
    icon: 'simulation',
    title: 'High-performance Simulation',
    description:
      'Immersive, high-stakes scenarios that let leaders rehearse the moments that define them — before they happen for real.',
    href: '/services#high-performance-simulation',
  },
  {
    icon: 'journeys',
    title: 'Bespoke Learning Journeys',
    description:
      'Multi-stage development programmes designed around your organisation, your context, and the outcomes you need.',
    href: '/services#bespoke-learning-journeys',
  },
] as const;

const challenges = [
  "You're delivering on the outside, but feeling increasingly depleted beneath the surface.",
  "You have strong ideas, but they do not always land when the stakes are high.",
  "You're valued as an expert, but not yet seen as a strategic leader.",
];
---

<BaseLayout
  title="Lead At Your Peak | Leadership Development and Executive Coaching"
  description="We help leaders and teams in high-pressure environments strengthen presence and performance to lead with influence and impact."
>
  <Header slot="header" />

  <main>
    <!-- 1 · Hero -->
    <!-- Fills the viewport below the header, but never stretches past 56rem on tall screens -->
    <section class="relative flex h-[calc(100svh-4rem)] max-h-[56rem] min-h-[34rem] items-center bg-navy-950 md:h-[calc(100svh-5rem)]">
      <Image
        src={heroPhoto}
        alt="Karolina Gwinner facilitating a leadership session for a room of senior leaders"
        class="absolute inset-0 h-full w-full object-cover object-[70%_20%] md:object-[70%_15%] lg:object-[70%_20%]"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/90 via-navy-900/55 to-navy-900/15"></div>
      <Container class="relative py-24 text-white md:py-32">
        <div class="max-w-2xl">
          <p class="eyebrow eyebrow--on-dark">Leadership development and executive coaching</p>
          <h1 class="mt-4 text-4xl leading-tight sm:text-5xl md:text-6xl">
            Lead At Your Peak When The Stakes Are High
          </h1>
          <PeakAccent class="mt-6" />
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
            We help leaders and teams in high-pressure environments strengthen presence and performance
            to lead with influence and impact.
          </p>
          <div class="mt-9">
            <Button href="#services" variant="gold">Explore Our Services</Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- 2 · Problem / Solution -->
    <Section bg="white" id="challenges">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
          <FadeIn>
            <p class="eyebrow">Sound familiar?</p>
            <h2 class="mt-3 text-3xl md:text-4xl">Crushing it at work, but&hellip;</h2>
            <p class="mt-5 max-w-xl leading-relaxed text-ink/80">
              You've built a strong track record. You're capable, ambitious, and trusted to deliver.
              But success at this level brings a different set of challenges.
            </p>
            <p class="mt-4 font-heading font-semibold text-navy-800">Which of these feels most familiar?</p>
            <ul class="mt-5 space-y-4">
              {
                challenges.map((challenge) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy-800/5 text-gold-600">
                      <Icon name="peak" class="h-3.5 w-3.5" />
                    </span>
                    <span class="leading-relaxed text-ink/85">{challenge}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-7 max-w-xl leading-relaxed text-ink/80">
              The next level does not simply ask for more effort. It calls for a different way of leading. 
              <br><br>
              That's where we come in. We turn insights from neuroscience and science of human performance into
              practical tools that help leaders strengthen their presence, communicate with greater influence and perform at their peak, without running on fumes.
            </p>
          </FadeIn>
          <FadeIn delay={150} class="mx-auto w-full max-w-md lg:max-w-none">
            <div class="relative">
              <Image
                src={purposePhoto}
                alt="Karolina Gwinner standing confidently beside a window graphic reading Purpose Power"
                class="aspect-[3/4] w-full rounded-2xl object-cover shadow-xl shadow-navy-800/15"
                widths={[480, 768, 1024]}
                sizes="(min-width: 1024px) 420px, 90vw"
              />
            </div>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- 3 · Services -->
    <Section bg="cream" id="services">
      <Container>
        <div class="max-w-2xl">
          <p class="eyebrow">What we do</p>
          <h2 class="mt-3 text-3xl md:text-4xl">How We Partner With You</h2>
          <p class="mt-5 leading-relaxed text-ink/80">
            Through leadership development training, executive coaching, bespoke learning journeys,
            and powerful keynotes, we turn insight into action and intention into sustained impact.
          </p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            services.map((service, index) => (
              <FadeIn delay={index * 100}>
                <Card class="flex h-full flex-col">
                  <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-navy-800/5 text-gold-600">
                    <Icon name={service.icon} class="h-7 w-7" />
                  </span>
                  <h3 class="mt-5 text-xl">{service.title}</h3>
                  <p class="mt-3 flex-1 leading-relaxed text-ink/75">{service.description}</p>
                  <a
                    href={service.href}
                    class="mt-5 inline-flex items-center gap-2 font-heading text-sm font-semibold text-navy-800 transition hover:gap-3 hover:text-navy-600"
                  >
                    Learn More
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- 4 · Testimonials -->
    <Section bg="navy" id="testimonials">
      <Container>
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow eyebrow--on-dark">Client voices</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Trusted By Leaders Committed To Excellence</h2>
          <p class="mt-4 text-white/75">Discover what the clients think about our services</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            [
              {
                quote:
                  "Recently, I attended a workshop facilitated by Karolina. She brought great energy and a strong knowledge boost to the session. The training was a well-balanced blend of clearly presented theory and experience sharing, which made it highly practical, easy to follow, and unique. I recommend Karolina’s programmes to anyone who would like to explore and strengthen their leadership skills.",
                title: "Director of Reinsurance Accounting Operations",
                company: "Munich Re",
                initials: "MR",
              },
              {
                quote:
                  "I attended a workshop that Karolina ran and found her very personable and energising. Her enthusiasm definitely empowered me to take action. She gave us some useful take-away tips that I found very easy to implement. I would definitely attend another of Karolina's sessions and recommend her as an inspiring, engaging and patient trainer with the passion to help and support people to perform better.",
                title: "Human Resources Director",
                company: "WTW (Willis Towers Watson)",
                initials: "WTW",
              },
            ].map((testimonial) => (
              <FadeIn>
                <Card class="h-full bg-white/95">
                  <PeakAccent variant="underline" />
                  <p class="mt-4 italic leading-relaxed text-ink/70">
                    “{testimonial.quote}”
                  </p>
                  <div class="mt-6 flex items-center gap-4">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-navy-100 text-navy-800">
                      <span class="text-xs font-bold">{testimonial.initials}</span>
                    </span>
                    <div>
                      <p class="font-heading text-sm font-bold text-ink">{testimonial.title}</p>
                      <p class="text-sm text-ink/60">{testimonial.company}</p>
                    </div>
                  </div>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- 5 · About teaser -->
    <Section bg="beige" id="about">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.2fr]">
          <FadeIn class="mx-auto w-full max-w-md lg:max-w-none">
            <Image
              src={founderPhoto}
              alt="Karolina Gwinner smiling during a coaching conversation"
              class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl shadow-navy-800/15"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 480px, 90vw"
            />
          </FadeIn>
          <FadeIn delay={150}>
            <p class="eyebrow">Who you'll work with</p>
            <h2 class="mt-3 text-3xl md:text-4xl">Leadership Development That Elevates Leaders</h2>
            <p class="mt-5 max-w-xl leading-relaxed text-ink/80">
              We partner with purpose-driven and ambitious organisations to develop high-performing
              leaders who lead with presence, influence, and clarity, even in complex, high-pressure
              environments. Our work draws on human performance science and the proven
              P.E.A.K.S.&trade; and A.L.I.G.N.&trade; frameworks.
            </p>
            <div class="mt-8">
              <Button href="/about" variant="gold">About Us</Button>
            </div>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- 6 · Newsletter -->
    <Section bg="navy" id="newsletter" class="relative">
      <Image
        src={newsletterPhoto}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_29%]"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <!-- Navy scrim keeps the copy and form legible over the photo -->
      <div class="absolute inset-0 bg-gradient-to-br from-navy-950/85 via-navy-900/75 to-navy-800/60"></div>
      <Container class="relative">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow eyebrow--on-dark">Weekly insights</p>
          <h2 class="mt-3 text-3xl md:text-4xl">The Edge Every Leader Needs</h2>
          <p class="mt-4 leading-relaxed text-white/80">
            Get our specially curated leadership insights to stay sharp, lead with presence and perform at your peak
            when the stakes are high.
          </p>
        </div>
        <div class="mt-9">
          <NewsletterForm onDark />
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
