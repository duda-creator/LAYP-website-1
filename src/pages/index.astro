---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';

import heroPhoto from '../assets/images/hero-session.jpg';
import founderPhoto from '../assets/images/founder-smiling.jpg';
import purposePhoto from '../assets/images/purpose-power-pose.jpg';
import newsletterPhoto from '../assets/images/Newsletter group of leaders smiling.jpg';

const services = [
  {
    icon: 'training',
    title: 'Leadership Development Training',
    description:
      'Practical, science-informed leadership development programmes and workshops that shift how leaders and teams show up, communicate, and deliver under pressure.',
    href: '/services#leadership-development-training',
  },
  {
    icon: 'coaching',
    title: 'Executive And Group Coaching',
    description:
      'Brain-based executive coaching, delivered one-to-one or in small cohorts, that empowers senior leaders to elevate presence, strengthen influence, and maximise impact.',
    href: '/services#executive-coaching',
  },
  {
    icon: 'simulation',
    title: 'High-energy Keynote Presentations',
    description:
      'Thought-provoking keynotes that challenge conventional thinking, spark meaningful conversations, and inspire leaders and teams to reach new levels of performance and impact.',
    href: '/services#keynote-presentations',
  },
  {
    icon: 'journeys',
    title: 'Custom Development Journeys',
    description:
      'Multi-stage leadership development journeys that address your organisation’s unique challenges, build critical capabilities, shift behaviours, and deliver impact across your organisation.',
    href: '/services#custom-development-journeys',
  },
] as const;

const challenges = [
  "You have strong ideas, but they don't always land under pressure.",
  "You're valued as an expert, but not yet seen as a strategic leader.",
  "You're delivering on the outside, but feeling increasingly depleted beneath the surface.",
];
---

<BaseLayout
  title="Lead At Your Peak | Leadership Development, Executive Coaching and Keynotes"
  description="We help leaders and teams in high-pressure environments strengthen presence and performance to lead with influence and impact."
>
  <Header slot="header" />

  <main>
    <!-- 1 · Hero -->
    <!-- Fills the viewport below the header, but never stretches past 56rem on tall screens -->
    <section class="relative flex h-[calc(100svh-4rem)] max-h-[56rem] min-h-[34rem] items-center bg-navy-950 md:h-[calc(100svh-5rem)]">
      <Image
        src={heroPhoto}
        alt="Karolina Gwinner facilitating a leadership session for a room of senior leaders"
        class="absolute inset-0 h-full w-full object-cover object-[70%_20%] md:object-[70%_15%] lg:object-[70%_20%]"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/90 via-navy-900/55 to-navy-900/15"></div>
      <Container class="relative py-24 text-white md:py-32">
        <div class="max-w-2xl">
          <p class="eyebrow eyebrow--on-dark">Leadership development | executive coaching </p>
          <h1 class="mt-4 text-4xl leading-tight sm:text-5xl md:text-6xl">
            Lead At Your Peak When The Stakes Are High
          </h1>
          <PeakAccent class="mt-6" />
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/85">
            We help leaders and teams in high-pressure environments strengthen presence and performance
            to lead with influence and impact.
          </p>
          <div class="mt-9">
            <Button href="#services" variant="primary">Explore Our Services</Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- 2 · Problem / Solution -->
    <Section bg="white" id="challenges">
      <Container>
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Sound familiar?</p>
          <h2 class="mt-3 text-3xl md:text-4xl">The Demands of Leadership Keep Rising</h2>
          <p class="mt-4 leading-relaxed text-ink/70">
            Whether you're developing leaders across your organisation or strengthening your own leadership impact, today's expectations call for new ways of leading and performing.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <FadeIn>
            <article class="flex h-full flex-col rounded-2xl bg-navy-800 p-7 text-white shadow-sm sm:p-8">
              <div class="flex items-center gap-3 border-b border-white/15 pb-5">
                <span class="text-gold-400"><Icon name="chart" class="h-6 w-6" /></span>
                <p class="eyebrow text-sm text-gold-400">For organisations</p>
              </div>
              <h3 class="mt-6 text-xl font-bold leading-snug sm:text-2xl">
                Your people are capable. Yet today's strengths may not be enough for tomorrow's challenges.
              </h3>
              <ol class="mt-6 flex-1 space-y-5 text-base leading-relaxed text-white/90">
                <li><span class="font-semibold">1.</span> Your leaders have the expertise, but it doesn't always translate into influence.</li>
                <li><span class="font-semibold">2.</span> Sustained pressure is taking a toll on energy, effectiveness and long-term performance.</li>
                <li><span class="font-semibold">3.</span> As pace and complexity increase, familiar ways of leading and working are falling short.</li>
              </ol>
              <Button href="/services" variant="gold" class="mt-8 w-full">Explore Leadership Solutions <span aria-hidden="true">→</span></Button>
            </article>
          </FadeIn>

          <FadeIn delay={150}>
            <article class="flex h-full flex-col rounded-2xl border border-gold-600/50 bg-white p-7 shadow-sm sm:p-8">
              <div class="flex items-center gap-3 border-b border-navy-800/10 pb-5">
                <span class="text-gold-600"><Icon name="user" class="h-6 w-6" /></span>
                <p class="eyebrow text-sm">For individual leaders</p>
              </div>
              <h3 class="mt-6 text-xl font-bold leading-snug text-navy-800 sm:text-2xl">
                You've built a strong track record. But what brought you success so far may not be what takes you further.
              </h3>
              <ol class="mt-6 flex-1 space-y-5 text-base leading-relaxed text-ink/85">
                <li><span class="font-semibold">1.</span> You have strong ideas, but they don't always land under pressure.</li>
                <li><span class="font-semibold">2.</span> You're valued as an expert, but not yet seen as a strategic leader.</li>
                <li><span class="font-semibold">3.</span> You're delivering on the outside, but feeling increasingly depleted beneath the surface.</li>
              </ol>
              <Button href="/services#executive-coaching" variant="secondary" class="mt-8 w-full border-gold-600 !bg-white text-navy-800 hover:!bg-white hover:text-navy-800">Explore Executive Coaching <span aria-hidden="true">→</span></Button>
            </article>
          </FadeIn>
        </div>

      </Container>
    </Section>

    <!-- 3 · Services -->
    <Section bg="cream" id="services">
      <Container>
        <div>
          <p class="eyebrow">Our Solutions</p>
          <h2 class="mt-3 text-3xl md:text-4xl">How We Partner With You</h2>
          <p class="mt-5 leading-relaxed text-ink/80">
          Everything we do is designed to deliver measurable results and lasting shifts in mindset and behaviour. Our learning and development solutions are grounded in research in human performance science, neuroscience, and applied psychology, and powered by our proprietary frameworks, including P.E.A.K.S.™ and A.L.I.G.N.™.
          </p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            services.map((service, index) => (
              <FadeIn delay={index * 100}>
                <Card class="flex h-full flex-col">
                  <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-navy-800/5 text-gold-600">
                    <Icon name={service.icon} class="h-7 w-7" />
                  </span>
                  <h3 class="mt-5 text-xl">{service.title}</h3>
                  <p class="mt-3 flex-1 leading-relaxed text-ink/75">{service.description}</p>
                  <a
                    href={service.href}
                    class="mt-5 inline-flex items-center gap-2 font-heading text-sm font-semibold text-navy-800 transition hover:gap-3 hover:text-navy-600"
                  >
                    Learn More
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- 4 · Testimonials -->
    <Section bg="navy" id="testimonials">
      <Container>
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow eyebrow--on-dark">Client voices</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Trusted By Leaders Committed To Peak Performance</h2>
          <p class="mt-4 text-white/75">Discover what the clients think about our services</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            [
              {
                quote:
                  "Recently, I attended a workshop facilitated by Karolina. She brought great energy and a strong knowledge boost to the session. The training was a well-balanced blend of clearly presented theory and experience sharing, which made it highly practical, easy to follow, and unique. I recommend Karolina’s programmes to anyone who would like to explore and strengthen their leadership skills.",
                title: "Director of Reinsurance Accounting Operations",
                company: "Munich Re",
                initials: "MR",
              },
              {
                quote:
                  "I attended a workshop that Karolina ran and found her very personable and energising. Her enthusiasm definitely empowered me to take action. She gave us some useful take-away tips that I found very easy to implement. I would definitely attend another of Karolina's sessions and recommend her as an inspiring, engaging and patient trainer with the passion to help and support people to perform better.",
                title: "Human Resources Director",
                company: "WTW (Willis Towers Watson)",
                initials: "WTW",
              },
              {
                quote:
                  "Karolina ran an excellent Executive Presence session for our senior LCN group in Singapore. She was extremely well prepared, highly engaging and created a genuinely interactive discussion rather than delivering a lecture. She challenged the group in the right way, prompting thoughtful reflection while sharing practical ideas that people could take straight into their day-to-day roles. It was a strong session for a senior audience: relevant, well-paced and with plenty of useful takeaways. Thank you, Karolina!",
                title: "Global Consultant Relations",
                company: "Pictet Asset Management",
                initials: "PAM",
              },
            ].map((testimonial) => (
              <FadeIn>
                <Card class="h-full bg-white/95">
                  <PeakAccent variant="underline" />
                  <p class="mt-4 italic leading-relaxed text-ink/70">
                    “{testimonial.quote}”
                  </p>
                  <div class="mt-6 flex items-center gap-4">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-navy-100 text-navy-800">
                      <span class="text-xs font-bold">{testimonial.initials}</span>
                    </span>
                    <div>
                      <p class="font-heading text-sm font-bold text-ink">{testimonial.title}</p>
                      <p class="text-sm text-ink/60">{testimonial.company}</p>
                    </div>
                  </div>
                </Card>
              </FadeIn>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- 5 · About teaser -->
    <Section bg="beige" id="about">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.2fr]">
          <FadeIn class="relative mx-auto w-full max-w-md overflow-hidden rounded-2xl shadow-xl shadow-navy-800/15 lg:max-w-none">
            <Image
              src={founderPhoto}
              alt="Karolina Gwinner smiling during a coaching conversation"
              class="block aspect-[4/3] w-full object-cover object-center"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 480px, 90vw"
            />
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-navy-800/10 via-navy-800/15 to-navy-900/30"></div>
          </FadeIn>
          <FadeIn delay={150}>
            <p class="eyebrow">Who you'll work with</p>
            <h2 class="mt-3 text-3xl md:text-4xl">A Partner Who Understands Leadership Under Pressure</h2>
            <p class="mt-5 max-w-xl leading-relaxed text-ink/80">
              Founded by Karolina Gwinner, Lead at Your Peak brings together extensive corporate experience, a deep understanding of human behaviour, and brain-based approaches to leadership development. We combine research-backed insights with practical, engaging learning experiences that create meaningful and lasting change.
            </p>
            <div class="mt-8">
              <Button href="/about" variant="gold">Get to Know Us</Button>
            </div>
          </FadeIn>
        </div>
      </Container>
    </Section>

    <!-- 6 · Newsletter -->
    <Section bg="navy" id="newsletter" class="relative">
      <Image
        src={newsletterPhoto}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_29%]"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <!-- Navy scrim keeps the copy and form legible over the photo -->
      <div class="absolute inset-0 bg-gradient-to-br from-navy-950/85 via-navy-900/75 to-navy-800/60"></div>
      <Container class="relative">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow eyebrow--on-dark mx-auto text-center">Leadership Insights</p>
          <h2 class="mt-3 text-3xl md:text-4xl">The Edge Every Leader Needs</h2>
          <p class="mt-4 leading-relaxed text-white/80">
            Get our curated insights and resources to stay sharp, lead with presence,<br class="hidden md:block" />
            and perform at your peak when the stakes are high.
          </p>
        </div>
        <div class="mt-9">
          <NewsletterForm onDark />
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
