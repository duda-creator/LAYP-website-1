---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';

import trainingPhoto from '../assets/images/leadership-training.jpg';
import coachingPhoto from '../assets/images/Karolina coaching a female senior leader.png';
import journeysPhoto from '../assets/images/unilever-event-drive-performance.jpg';
import keynotePhoto from '../assets/images/Leadership keynote speaker Karolina Gwinner.JPG';

const services = [
  {
    id: 'leadership-development-training',
    icon: 'training',
    title: 'Leadership Development Training',
    photo: trainingPhoto,
    alt: 'Karolina Gwinner facilitating a lively training discussion among corporate leaders',
    description:
      'Going beyond skills-based training, our interactive leadership programmes and workshops help participants develop practical behaviours and sustainable habits. Through experiential learning and real-world application, we equip leaders and teams to navigate complexity, perform under pressure, and deliver lasting results.',
    who: 'Mid-to-senior leaders, executives, people managers, team leads, and high-potential leaders who need to communicate, influence, and perform in complex, high-pressure environments.',
    included: [
      'Engaging, facilitated learning experiences, in person or virtually',
      'Pre-programme assessment to tailor learning to participants’ needs',
      'Practical tools and science-backed strategies for immediate application',
      'Post-programme support to embed learning and sustain behaviour change',
    ],
    outcomes: [
      'Stronger credibility and trust in high-stakes situations',
      'Greater stakeholder buy-in and influence across organisational boundaries',
      'Clear, composed conversations through pressure and uncertainty',
      'More ownership, talent development, and performance through others',
      'Sustainable performance through sharper priorities and better capacity management',
    ],
    offerings: [
      {
        title: 'Mastering Executive Presence',
        subtitle: 'Turning expertise into influence and impact when the stakes are high',
        description:
          'Expertise alone doesn’t guarantee influence. This workshop helps organisations develop leaders who communicate with credibility, build trust and turn their expertise into meaningful influence.',
        who: 'Mid-to-senior leaders, executives, people managers, team leads',
        outcomes: [
          {
            title: 'Stronger leadership credibility',
            description: 'Build presence that inspires confidence and trust.',
          },
          {
            title: 'Greater stakeholder buy-in',
            description: 'Communicate ideas persuasively and influence across organisational boundaries.',
          },
          {
            title: 'More effective high-stakes conversations',
            description: 'Navigate pressure, challenge, and uncertainty with clarity and composure.',
          },
        ],
      },
      {
        title: 'Sustainable Peak Performance',
        subtitle: 'Thriving in an accelerating AI-driven workplace',
        description:
          `AI can help people work faster. But making employees faster isn't the same as making organisations more effective. This workshop helps leaders and teams rethink how work gets done, eliminate unnecessary demands and turn increased capacity into sustainable performance.`,
        who: 'Mid-to-senior leaders, executives, people managers, team leads, high-potential leaders, and teams',
        outcomes: [
          {
            title: 'Sharper priorities and greater productivity',
            description: 'Eliminate low-value work and focus effort where it creates the most impact.',
          },
          {
            title: 'Better decisions under pressure',
            description: 'Strengthen attention management, emotional regulation, and decision quality.',
          },
          {
            title: 'Sustainable high performance',
            description: 'Manage capacity and energy to deliver results without chronic overload.',
          },
        ],
      },
      {
        title: 'From Expert to Enabler',
        subtitle: 'Building high-performing teams without becoming the bottleneck',
        description:
          'When managers become the default problem-solvers, team capability and organisational agility suffer. This workshop equips leaders to shift from doing and directing to coaching, empowering and developing others.',
        who: 'Mid-to-senior leaders, executives, people managers, team leads',
        outcomes: [
          {
            title: 'Greater team ownership',
            description: 'Delegate effectively and build accountability without micromanaging.',
          },
          {
            title: 'Stronger talent development',
            description: 'Use coaching and real-work assignments to accelerate employee growth.',
          },
          {
            title: 'Increased managerial capacity',
            description: 'Reduce dependency on individual leaders and free up time for strategic priorities.',
          },
        ],
      },
    ],
  },
  {
    id: 'executive-coaching',
    icon: 'coaching',
    title: 'Executive, Group and Team Coaching',
    photo: coachingPhoto,
    alt: 'Karolina Gwinner coaching a female senior leader',
    description:
      'Under pressure, even highly capable leaders and teams can fall back on patterns that limit their influence, effectiveness, and energy. Our brain-based coaching helps them recognise these patterns, respond with greater awareness and flexibility, and turn insights into lasting behaviour change.',
    descriptionContinuation:
      'Each engagement is tailored to your organisation’s challenges and priorities, with a focus on meaningful, measurable shifts in how people show up, work together, and perform.',
    who: 'Executives, senior leaders, directors, and high-potential talent stepping into bigger roles, navigating change, or strengthening their impact. Small cohorts and leadership teams can work on shared challenges, alignment, and collective performance.',
    included: [
      'Confidential, structured engagements for individuals, small groups, or intact teams',
      'Development goals aligned with individual and organisational priorities',
      'Brain-based tools, reflection, and practical work on real leadership challenges',
      'Between-session application, peer accountability, and progress reviews',
    ],
    outcomes: [
      'Stronger presence, credibility, and influence in high-stakes interactions',
      'Better management of energy, focus, and pressure',
      'More strategic thinking, sound judgement, and adaptability',
      'Aligned decisions, stronger collaboration, and shared accountability',
      'Lasting behaviour change that improves day-to-day performance',
    ],
    offerings: [
      {
        title: '01. One-to-One Executive Coaching',
        description:
          'Personalised, confidential coaching that helps leaders navigate complex challenges, strengthen their leadership impact, and perform at their peak without overextending themselves.',
        who: 'Executives, senior leaders, directors, and high-potential talent stepping into bigger roles, navigating organisational change, or looking to strengthen their executive presence, influence, and effectiveness.',
        included: [
          'Confidential, structured one-to-one coaching engagements',
          'Clear development goals aligned with individual and organisational priorities',
          'Brain-based coaching tools and proprietary frameworks, including A.L.I.G.N.™ and P.E.A.K.S.™, as relevant',
          'Practical application to real leadership challenges between sessions',
          'Progress reviews against agreed goals, with appropriate confidentiality safeguards',
        ],
      },
      {
        title: '02. Group Coaching',
        description:
          'A powerful combination of personalised development and collective learning, where leaders learn from one another, challenge their assumptions, and build new leadership habits together.',
        who: 'Small cohorts of managers, directors, and emerging senior leaders facing similar leadership challenges. Particularly valuable as part of leadership development programmes, high-potential talent initiatives, or succession planning.',
        included: [
          'Facilitated coaching sessions in small, focused cohorts',
          'Shared development themes aligned with organisational priorities',
          'Guided reflection, peer coaching, and practical exploration of real leadership challenges',
          'Between-session application and peer accountability to reinforce new behaviours',
          'Integration with broader leadership development journeys where relevant',
        ],
      },
      {
        title: '03. Team Coaching',
        description:
          'Coaching that helps leadership teams move beyond individual excellence to stronger collective performance, building the trust, alignment, and ways of working needed to deliver results together.',
        who: 'Executive teams, functional leadership teams, and cross-functional leadership teams seeking to improve collaboration, navigate change, strengthen alignment, or elevate collective performance.',
        included: [
          'Team discovery and assessment of current dynamics, challenges, and priorities',
          'Facilitated coaching sessions focused on real team interactions and business challenges',
          'Practical work on trust, communication, constructive challenge, and decision-making',
          'Shared commitments to strengthen collaboration and accountability',
          'Follow-through and progress reviews to embed more effective ways of working',
        ],
      },
    ],
  },
  {
    id: 'custom-learning-journeys',
    icon: 'journeys',
    title: 'Custom Learning Journeys',
    photo: journeysPhoto,
    alt: 'Leaders gathered at a corporate event focused on performance and development',
    description:
      'Building lasting leadership capability at scale takes more than a one-off workshop. We design multi-stage learning journeys around your organisation’s challenges, strategic priorities, and leadership needs. By integrating assessment, experiential workshops, high-performance simulations, coaching, practical application, and ongoing reinforcement, we help leaders translate insight into lasting habits and behaviours.',
    when: 'When your organisation is navigating transformation, strengthening its leadership pipeline, or seeking to embed consistent leadership behaviours across teams and levels.',
    partner:
      "We partner with HR, L&D, and talent leaders to co-design and deliver custom learning journeys aligned with their organisation's strategic priorities and leadership challenges.",
    who: 'High-potential talent, emerging leaders, senior leaders, and leadership teams.',
    included: [
      'Discovery and co-design aligned to organisational priorities and desired outcomes',
      'A tailored, multi-stage learning architecture that builds capability progressively',
      'Blended workshops, coaching, simulations, and peer learning',
      'Opportunities to practise, reflect, and apply behaviours in real work',
      'Measurement against agreed objectives, with refinement as needed',
    ],
    outcomes: [
      'A stronger leadership pipeline equipped to navigate complexity and influence others',
      'Shared leadership language and behaviours across the organisation',
      'Sustained behaviour change beyond the learning experience',
      'Development connected to business priorities and measurable performance outcomes',
    ],
    offerings: [],
  },
  {
    id: 'keynote-presentations',
    icon: 'training',
    title: 'High-Energy Keynote Presentations',
    photo: keynotePhoto,
    alt: 'Karolina Gwinner engaging an audience during a keynote presentation',
    description:
      'A powerful keynote does more than energise an audience. It changes how people think, challenges what they take for granted, and sparks conversations that continue beyond the event. Our thought-provoking presentations blend compelling storytelling, audience interaction, and research-backed insights to make complex ideas accessible, relevant, and memorable.',
    when:
      'When an event needs to challenge conventional thinking, energise an audience, and spark conversations that continue beyond the event.',
    partner:
      'Event organisers, HR and L&D leaders, and organisations planning corporate conferences, leadership summits, executive offsites, town halls, and professional events.',
    who: 'Leaders and teams attending corporate conferences, leadership summits, executive offsites, town halls, and professional events.',
    included: [
      'Pre-event discovery aligned to your audience, objectives, and key messages',
      'Tailored content, examples, and insights for your organisation',
      'High-energy, interactive delivery grounded in research',
      'Practical takeaways participants can apply beyond the event',
    ],
    outcomes: [
      'Fresh perspectives that challenge assumptions about leadership and performance',
      'Greater awareness of the behaviours that shape influence and effectiveness',
      'Actionable ideas for how participants lead, collaborate, and perform',
      'Shared language and conversations that continue after the event',
    ],
    offerings: [
      {
        title: "When Expertise Isn't Enough",
        subtitle: 'The Power of Presence Under Pressure',
        challenge:
          "Expertise may earn leaders a seat at the table, but it doesn't guarantee their ideas will shape what happens next. This thought-provoking keynote challenges conventional thinking about executive presence and explores what it really takes to build credibility, inspire trust, and influence decisions when the stakes are high.",
        shift:
          'Audiences gain a fresh perspective on how leaders can turn their expertise into greater influence and meaningful impact.',
      },
      {
        title: 'The Performance Trap',
        subtitle: "Why Pushing Harder Isn't the Answer in an AI-Accelerated World",
        challenge:
          'As AI accelerates the pace of work, organisations face growing pressure to achieve more, faster. But what if pushing harder is undermining the very capabilities that drive high performance?',
        shift:
          'Grounded in neuroscience and human performance science, this keynote challenges conventional thinking about productivity and explores how leaders and teams can harness their uniquely human strengths, manage energy and attention, and thrive alongside AI rather than struggle to keep pace with it.',
      },
      {
        title: 'The Bottleneck Paradox',
        subtitle: 'When Your Greatest Strength Holds Your Team Back',
        challenge:
          'What if the very strengths that make leaders successful are also holding their teams back? When leaders become the go-to problem solvers, they can unintentionally limit ownership, initiative, and performance across their teams.',
        shift:
          'This keynote challenges leaders to rethink their greatest contribution, exploring the critical shift from expert to enabler and how to create the conditions for others to perform at their peak.',
      },
    ],
  },
] as const;
---

<BaseLayout
  title="Services | Lead At Your Peak"
  description="Leadership development training, executive and team coaching, custom learning journeys, and high-energy keynote presentations for leaders, teams and organisations."
>
  <Header slot="header" />

  <main>
    <!-- Hero -->
    <Section bg="navy" class="relative overflow-hidden">
      <PeakAccent variant="watermark" class="absolute -right-10 bottom-0 h-64 w-auto opacity-25" />
      <Container class="relative max-w-3xl text-center">
        <p class="eyebrow eyebrow--on-dark">Our services</p>
        <h1 class="mt-4 text-4xl md:text-5xl">Elevating Leaders And Teams</h1>
        <div class="mt-6 flex justify-center"><PeakAccent /></div>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
          We partner with ambitious organisations to build leadership capabilities, strengthen team effectiveness,
          and turn pressure into peak performance.
        </p>
      </Container>
    </Section>

    <!-- Service sections, alternating image/text -->
    {
      services.map((service, index) => (
        <Section id={service.id} bg={index % 2 === 0 ? 'white' : 'cream'}>
          <Container>
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <FadeIn class:list={[index % 2 === 1 && 'lg:order-2']}>
                <Image
                  src={service.photo}
                  alt={service.alt}
                  class:list={[
                    service.id === 'custom-learning-journeys' || service.id === 'keynote-presentations'
                      ? 'h-auto w-full rounded-2xl shadow-xl shadow-navy-800/15'
                      : 'aspect-[4/3] w-full rounded-2xl object-cover shadow-xl shadow-navy-800/15',
                  ]}
                  widths={[480, 768, 1200]}
                  sizes="(min-width: 1024px) 560px, 90vw"
                />
              </FadeIn>
              <FadeIn delay={100}>
                <span
                  class:list={[
                    'inline-flex items-center justify-center rounded-xl bg-navy-800/5 text-gold-600',
                    service.id === 'keynote-presentations' ? 'h-10 w-10' : 'h-14 w-14',
                  ]}
                >
                  <Icon
                    name={service.icon}
                    class:list={[service.id === 'keynote-presentations' ? 'h-5 w-5' : 'h-7 w-7']}
                  />
                </span>
                <h2 class="mt-5 text-3xl">{service.title}</h2>
                <p class="mt-4 leading-relaxed text-ink/80">{service.description}</p>
                {service.id === 'executive-coaching' && (
                  <p class="mt-4 leading-relaxed text-ink/80">{service.descriptionContinuation}</p>
                )}

                {service.id === 'custom-learning-journeys' ? (
                  <>
                    <h3 class="eyebrow mt-7">When it matters most</h3>
                    <p class="mt-2 leading-relaxed text-ink/80">{service.when}</p>
                  </>
                ) : service.id === 'keynote-presentations' ? (
                  <>
                    <h3 class="eyebrow mt-7">When it matters most</h3>
                    <p class="mt-2 leading-relaxed text-ink/80">{service.when}</p>
                  </>
                ) : null}

                {service.id !== 'custom-learning-journeys' && service.id !== 'keynote-presentations' && (
                  <div
                    class:list={[
                      'mt-7 grid gap-7',
                      service.id !== 'leadership-development-training' &&
                        service.id !== 'executive-coaching' &&
                        'sm:grid-cols-2',
                    ]}
                  >
                    {service.id !== 'executive-coaching' && (
                      <div>
                        <h3 class="eyebrow">What's included</h3>
                        <ul class="mt-3 space-y-2.5">
                          {service.included.map((item) => (
                            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink/80">
                              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" />
                              {item}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {service.id !== 'leadership-development-training' && (
                      <div>
                        <h3 class="eyebrow">Outcomes</h3>
                        <ul class="mt-3 space-y-2.5">
                          {service.outcomes.map((item) => (
                            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink/80">
                              <Icon name="peak" class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" />
                              {item}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}

              </FadeIn>
            </div>
            {service.id === 'custom-learning-journeys' && (
              <article class="mt-12 overflow-hidden rounded-[14px] border border-navy-800/10 border-t-4 border-t-gold-600 bg-white p-6 shadow-sm md:p-10 lg:p-12">
                <div class="grid gap-7 md:grid-cols-[3fr_2fr] md:gap-8">
                  <div class="md:border-r md:border-navy-800/10 md:pr-8">
                    <h3 class="eyebrow">Who we partner with</h3>
                    <p class="mt-3 leading-relaxed text-ink/80">{service.partner}</p>
                  </div>
                  <div>
                    <h3 class="eyebrow">Who it's for</h3>
                    <p class="mt-3 leading-relaxed text-ink/80">{service.who}</p>
                  </div>
                </div>
                <div class="mt-8 grid gap-8 border-t border-navy-800/10 pt-8 lg:grid-cols-[3fr_2fr]">
                  <div class="lg:border-r lg:border-navy-800/10 lg:pr-8">
                    <h3 class="eyebrow">What's included</h3>
                    <ul class="mt-4 space-y-3">
                      {service.included.map((item) => (
                        <li class="flex items-start gap-3 leading-relaxed text-ink/80">
                          <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-gold-600" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h3 class="eyebrow">Outcomes</h3>
                    <ul class="mt-4 space-y-3">
                      {service.outcomes.map((item) => (
                        <li class="flex items-start gap-3 leading-relaxed text-ink/80">
                          <Icon name="peak" class="mt-1 h-4 w-4 shrink-0 text-gold-600" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
              <aside class="mt-10 rounded-[14px] bg-navy-800 p-6 sm:p-10 lg:p-16">
                <div class="text-center">
                  <p class="eyebrow eyebrow--on-dark">Take the next step</p>
                  <h3 class="mt-4 font-heading text-3xl font-bold leading-tight text-white sm:text-4xl">
                    Have a specific leadership challenge in mind?
                  </h3>
                </div>
                <span aria-hidden="true" class="mt-8 block h-px w-full bg-white/20"></span>
                <div class="mt-7 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-10">
                  <p class="max-w-2xl leading-relaxed text-white/80">
                    Let's design a learning journey tailored to your organisation's priorities, leadership needs, and desired outcomes.
                  </p>
                  <div class="flex justify-start sm:justify-end">
                    <Button href="/contact" variant="primary" class="px-4 text-sm sm:px-6 sm:text-base">
                      Let's Design Your Learning Journey
                    </Button>
                  </div>
                </div>
              </aside>
            )}
            {service.offerings.length > 0 && (
              service.id === 'leadership-development-training' ? (
                <>
                  <div class="mt-12 rounded-2xl bg-cream/70 p-5 md:p-8 lg:p-10">
                    <h3 class="mb-7 border-l-4 border-gold-600 pl-4 font-heading text-2xl font-bold text-navy-800 md:text-3xl">
                      OUR SIGNATURE PROGRAMMES
                    </h3>
                    <div class="grid gap-6">
                      {service.offerings.map((offering, index) => (
                        'who' in offering && (
                          <article class="grid overflow-hidden rounded-[14px] border border-navy-800/10 border-t-4 border-t-gold-600 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg md:grid-cols-[2fr_3fr] md:gap-8 md:p-10">
                            <div class="md:border-r md:border-navy-800/10 md:pr-8">
                              <p class="text-xs font-semibold uppercase tracking-widest text-gold-600">
                                {String(index + 1).padStart(2, '0')} / SIGNATURE PROGRAMME
                              </p>
                              <h4 class="mt-4 font-heading text-2xl font-bold leading-tight text-navy-800 md:text-3xl">
                                {offering.title}
                              </h4>
                              <p class="mt-4 text-base font-medium leading-relaxed text-ink/80 md:text-lg">
                                {offering.subtitle}
                              </p>
                            </div>
                            <div class="mt-6 md:mt-0">
                              <h5 class="eyebrow mb-2">WHY IT MATTERS</h5>
                              <p class="leading-relaxed text-ink/80">{offering.description}</p>
                              <div class="mt-6 border-t border-navy-800/10 pt-5">
                                <h5 class="eyebrow">WHO IT'S FOR</h5>
                                <p class="mt-2 leading-relaxed text-ink/80">{offering.who}</p>
                              </div>
                              <div class="mt-6 border-t border-navy-800/10 pt-5">
                                <h5 class="eyebrow">Workshop outcomes</h5>
                                <ul class="mt-3 space-y-3">
                                  {offering.outcomes.map((outcome) => (
                                    <li class="text-base leading-relaxed text-ink/75">
                                      <strong class="font-semibold text-ink">{outcome.title}:</strong>{' '}
                                      {outcome.description}
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            </div>
                          </article>
                        )
                      ))}
                    </div>
                  </div>
                  <aside class="mt-10 rounded-[14px] bg-navy-800 p-6 sm:p-10 lg:p-16">
                    <div class="text-center">
                      <p class="eyebrow eyebrow--on-dark">Take the next step</p>
                      <h3 class="mt-4 font-heading text-3xl font-bold leading-tight text-white sm:text-4xl">
                        Ready to Elevate Your Leaders' Impact?
                      </h3>
                    </div>
                    <span aria-hidden="true" class="mt-8 block h-px w-full bg-white/20"></span>
                    <div class="mt-7 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-10">
                      <p class="max-w-2xl leading-relaxed text-white/80">
                        Explore how our signature leadership programmes can help address your organisation's most pressing challenges. Let's discuss your priorities and find the right fit for your leaders and teams.
                      </p>
                      <div class="flex justify-start sm:justify-end">
                        <Button href="/contact" variant="primary" class="px-4 text-sm sm:px-6 sm:text-base">
                          Let's Discuss Your Priorities
                        </Button>
                      </div>
                    </div>
                  </aside>
                </>
              ) : service.id === 'executive-coaching' ? (
                <div class="mt-12 grid gap-6">
                  {service.offerings.map((offering) => (
                    'who' in offering && 'included' in offering && (
                      <article class="grid overflow-hidden rounded-[14px] border border-navy-800/10 border-t-4 border-t-gold-600 bg-white p-6 shadow-sm md:grid-cols-[2fr_3fr] md:gap-8 md:p-10">
                        <div class="md:border-r md:border-navy-800/10 md:pr-8">
                          <h4 class="font-heading text-2xl font-bold leading-tight text-navy-800 md:text-3xl">
                            {offering.title}
                          </h4>
                          <p class="mt-4 leading-relaxed text-ink/80">{offering.description}</p>
                        </div>
                        <div class="mt-6 space-y-6 md:mt-0">
                          <div>
                            <h5 class="eyebrow">WHO IT'S FOR</h5>
                            <p class="mt-2 leading-relaxed text-ink/80">{offering.who}</p>
                          </div>
                          <div class="border-t border-navy-800/10 pt-5">
                            <h5 class="eyebrow">WHAT'S INCLUDED</h5>
                            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-ink/80">
                              {offering.included.map((item) => <li>{item}</li>)}
                            </ul>
                          </div>
                        </div>
                      </article>
                    )
                  ))}
                </div>
                <aside class="mt-10 rounded-[14px] bg-navy-800 p-6 sm:p-10 lg:p-16">
                  <div class="text-center">
                    <p class="eyebrow eyebrow--on-dark">Take the next step</p>
                    <h3 class="mt-4 font-heading text-3xl font-bold leading-tight text-white sm:text-4xl">
                      Stronger Leaders. More Effective Teams.
                    </h3>
                  </div>
                  <span aria-hidden="true" class="mt-8 block h-px w-full bg-white/20"></span>
                  <div class="mt-7 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-10">
                    <p class="max-w-2xl leading-relaxed text-white/80">
                      Let's shape a coaching engagement around the leadership challenges and outcomes that matter most to your organisation.
                    </p>
                    <div class="flex justify-start sm:justify-end">
                      <Button href="/contact" variant="primary" class="px-4 text-sm sm:px-6 sm:text-base">
                        Discuss Your Coaching Needs →
                      </Button>
                    </div>
                  </div>
                </aside>
              ) : null
            )}
            {service.id === 'keynote-presentations' && (
              <>
                <article class="mt-12 overflow-hidden rounded-[14px] border border-navy-800/10 border-t-4 border-t-gold-600 bg-white p-6 shadow-sm md:p-10 lg:p-12">
                  <div class="grid gap-7 md:grid-cols-[3fr_2fr] md:gap-8">
                    <div class="md:border-r md:border-navy-800/10 md:pr-8">
                      <h3 class="eyebrow">Who we partner with</h3>
                      <p class="mt-3 leading-relaxed text-ink/80">{service.partner}</p>
                    </div>
                    <div>
                      <h3 class="eyebrow">Who it's for</h3>
                      <p class="mt-3 leading-relaxed text-ink/80">{service.who}</p>
                    </div>
                  </div>
                  <div class="mt-8 grid gap-8 border-t border-navy-800/10 pt-8 lg:grid-cols-[3fr_2fr]">
                    <div class="lg:border-r lg:border-navy-800/10 lg:pr-8">
                      <h3 class="eyebrow">What's included</h3>
                      <ul class="mt-4 space-y-3">
                        {service.included.map((item) => (
                          <li class="flex items-start gap-3 leading-relaxed text-ink/80">
                            <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-gold-600" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h3 class="eyebrow">Outcomes</h3>
                      <ul class="mt-4 space-y-3">
                        {service.outcomes.map((item) => (
                          <li class="flex items-start gap-3 leading-relaxed text-ink/80">
                            <Icon name="peak" class="mt-1 h-4 w-4 shrink-0 text-gold-600" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </article>
                <div class="mt-12">
                  <h3 class="mb-8 font-heading text-2xl font-bold text-navy-800 md:text-3xl">
                    Signature Keynote Topics
                  </h3>
                  <div class="grid gap-8">
                    {service.offerings.map((offering, index) => (
                      <article class="rounded-[14px] border border-navy-800/10 border-t-2 border-t-gold-600 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-navy-800/20 hover:shadow-md sm:p-8 lg:p-10">
                        <div class="grid gap-6 md:grid-cols-[3fr_5fr] md:gap-8 lg:gap-10">
                          <div>
                            <p class="text-xs font-semibold uppercase tracking-widest text-gold-600">
                              KEYNOTE {String(index + 1).padStart(2, '0')}
                            </p>
                            <h4 class="mt-3 font-heading text-2xl font-bold leading-tight text-navy-800 md:text-3xl">
                              {offering.title}
                            </h4>
                            <p class="mt-3 text-sm font-medium leading-relaxed text-ink/70 md:text-base">
                              {offering.subtitle}
                            </p>
                          </div>
                          <div class="space-y-5 md:border-l md:border-navy-800/10 md:pl-8 lg:pl-10">
                            <div>
                              <h5 class="eyebrow">The challenge</h5>
                              <p class="mt-2 leading-relaxed text-ink/80">{offering.challenge}</p>
                            </div>
                            <div class="border-t border-navy-800/10 pt-5">
                              <h5 class="eyebrow">The shift</h5>
                              <p class="mt-2 leading-relaxed text-ink/80">{offering.shift}</p>
                            </div>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
                <aside class="mt-10 rounded-[14px] bg-navy-800 p-6 sm:p-10 lg:p-16">
                  <div class="text-center">
                    <p class="eyebrow eyebrow--on-dark">Take the next step</p>
                    <h3 class="mt-4 font-heading text-3xl font-bold leading-tight text-white sm:text-4xl">
                      Plan a Keynote for Your Next Event
                    </h3>
                  </div>
                  <span aria-hidden="true" class="mt-8 block h-px w-full bg-white/20"></span>
                  <div class="mt-7 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-10">
                    <p class="max-w-2xl leading-relaxed text-white/80">
                      Let's align the presentation with your audience, objectives, and key messages.
                    </p>
                    <div class="flex justify-start sm:justify-end">
                      <Button href="/contact" variant="primary" class="px-4 text-sm sm:px-6 sm:text-base">
                        Schedule a Consultation
                      </Button>
                    </div>
                  </div>
                </aside>
              </>
            )}
          </Container>
        </Section>
      ))
    }

  </main>

  <Footer slot="footer" />
</BaseLayout>
