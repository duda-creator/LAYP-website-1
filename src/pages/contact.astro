---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import contactPhoto from '../assets/images/Contact Us Karolina Gwinner.jpg';
import ContactForm from '../components/ContactForm.astro';
import Container from '../components/Container.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="Contact | Lead At Your Peak"
  description="Get in touch or book a discovery call to explore leadership development training, executive coaching, and bespoke programmes for your organisation."
>
  <Header slot="header" />

  <main>
    <!-- Hero -->
    <Section bg="navy" class="relative overflow-hidden">
      <PeakAccent variant="watermark" class="absolute -right-10 bottom-0 h-64 w-auto opacity-25" />
      <Container class="relative max-w-5xl text-center">
        <p class="eyebrow eyebrow--on-dark">Contact Us</p>
        <h1 class="mt-4 text-4xl md:text-5xl">Let's Start Your Ascent</h1>
        <div class="mt-6 flex justify-center"><PeakAccent /></div>
        <p class="mx-auto mt-6 max-w-4xl text-balance text-lg leading-relaxed text-white/85">
          Whether you're looking to strengthen leadership and team performance across your organisation or grow your own leadership impact, we'd love to hear from you.
        </p>
      </Container>
    </Section>

    <Section bg="beige" id="message">
      <Container>
        <div class="contact-layout">
          <section class="contact-message" aria-labelledby="message-heading">
            <h2 id="message-heading">Send Us a Message</h2>
            <span class="contact-accent" aria-hidden="true"></span>
            <p class="contact-intro">Tell us about your context and what you'd like to achieve. We'll take it from there and be in touch within 1–2 business days.</p>
            <ContactForm />
          </section>

          <aside id="book" class="contact-card" aria-labelledby="talk-heading">
            <div class="contact-card-hero">
              <Image
                src={contactPhoto}
                alt="Karolina Gwinner smiling during a coaching conversation"
                widths={[320, 480, 640, 960]}
                sizes="(min-width: 768px) 280px, 70vw"
                class="contact-card-photo"
              />
              <div class="contact-card-copy">
                <h2 id="talk-heading">Prefer to Talk<br />It Through?</h2>
                <span class="contact-accent" aria-hidden="true"></span>
                <p>
                  Whatever your challenge<br />
                  or ambition, we're here<br />
                  to help you move forward.
                </p>
              </div>
            </div>

            <div class="contact-card-details">
              <p class="contact-options-intro">Here are a few ways to reach us.</p>
              <h3 class="contact-options-heading">Start a conversation.</h3>

              <div class="contact-actions">
                <a href="https://zcal.co/karolinagwinner" target="_blank" rel="noopener noreferrer" class="contact-action contact-action--primary">
                  <Icon name="calendar" class="h-6 w-6 shrink-0" />
                  <span>Schedule a Consultation</span>
                  <Icon name="arrow-right" class="contact-action-arrow shrink-0" />
                </a>
                <a href="https://wa.me/6592330165" target="_blank" rel="noopener noreferrer" class="contact-action">
                  <Icon name="message-circle" class="h-5 w-5 shrink-0" />
                  <span>Message Us on WhatsApp</span>
                  <Icon name="arrow-right" class="contact-action-arrow shrink-0" />
                </a>
                <a href="tel:+6592330165" class="contact-action">
                  <Icon name="phone" class="h-5 w-5 shrink-0" />
                  <span>Call Us on <span class="whitespace-nowrap">+65 9233 0165</span></span>
                  <Icon name="arrow-right" class="contact-action-arrow shrink-0" />
                </a>
              </div>
            </div>
          </aside>
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    align-items: start;
    gap: 2.5rem;
    max-width: 68rem;
    margin-inline: auto;
  }

  .contact-message {
    min-width: 0;
    padding-top: .5rem;
  }

  .contact-message h2 {
    color: var(--color-navy-950);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -.04em;
  }

  .contact-accent {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 1.25rem;
    background: var(--color-gold-600);
  }

  .contact-intro {
    margin-top: 1.25rem;
    margin-bottom: .25rem;
    color: rgb(20 40 63 / 75%);
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-card {
    container-type: inline-size;
    width: 100%;
    max-width: 25rem;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-beige);
    border-radius: .625rem;
    background: var(--color-cream);
    box-shadow: 0 8px 30px rgba(15, 35, 60, 0.05);
    text-align: center;
  }

  .contact-card-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(16rem, 67cqi, 19rem);
    overflow: hidden;
    background: var(--color-cream);
  }

  .contact-card-hero::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: .85;
    background: linear-gradient(
      90deg,
      var(--color-cream) 20%,
      rgb(246 245 242 / 100%) 28%,
      rgb(246 245 242 / 98%) 34%,
      rgb(246 245 242 / 92%) 40%,
      rgb(246 245 242 / 80%) 46%,
      rgb(246 245 242 / 62%) 52%,
      rgb(246 245 242 / 40%) 58%,
      rgb(246 245 242 / 20%) 64%,
      rgb(246 245 242 / 6%) 70%,
      rgb(246 245 242 / 0%) 78%
    );
  }

  .contact-card-photo {
    position: absolute;
    inset: 0 -10% 0 auto;
    width: 70%;
    height: 100%;
    object-fit: cover;
    object-position: 61% top;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgb(0 0 0 / 15%) 6%,
      rgb(0 0 0 / 50%) 12%,
      rgb(0 0 0 / 85%) 18%,
      #000 24%
    );
  }

  .contact-card-copy {
    position: relative;
    z-index: 2;
    width: 60%;
    padding: 2.5rem clamp(1.25rem, 6cqi, 1.75rem);
    padding-right: 0;
    text-align: left;
  }

  .contact-card-copy h2 {
    color: var(--color-navy-950);
    font-size: clamp(1.125rem, 6cqi, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.035em;
  }

  .contact-card-copy .contact-accent {
    margin-top: 1.25rem;
  }

  .contact-card-copy p {
    max-width: 11.875rem;
    margin-top: 1.25rem;
    color: var(--color-navy-950);
    font-size: clamp(.9375rem, 3.75cqi, 1.0625rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .contact-card-details {
    border-top: 1px solid rgb(255 255 255 / 90%);
    padding: 1.5rem clamp(1rem, 4cqi, 1.25rem) 1.5rem;
    background: var(--color-cream);
    text-align: left;
  }

  .contact-options-intro {
    padding-inline: .375rem;
    color: var(--color-navy-900);
    font-family: var(--font-heading);
    font-size: clamp(.875rem, 4cqi, 1.25rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .contact-options-heading {
    margin-top: .125rem;
    padding-inline: .375rem;
    color: var(--color-navy-950);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .contact-actions {
    display: grid;
    justify-items: stretch;
    gap: .8625rem;
    margin-top: 1.25rem;
  }

  .contact-action > span {
    min-width: 0;
  }

  .contact-action {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) .875rem;
    width: 100%;
    max-width: 100%;
    align-items: center;
    gap: .5rem;
    min-height: 3rem;
    padding: .75rem 1.5rem;
    border-radius: .5rem;
    background: #e9f0f5;
    color: var(--color-navy-950);
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: left;
    transition: background-color .2s, filter .2s;
  }

  .contact-action:hover {
    background: var(--color-navy-100);
  }

  .contact-action :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .contact-action :global(.contact-action-arrow) {
    width: .875rem;
    height: .875rem;
    stroke-width: 1.25;
  }

  .contact-actions .contact-action--primary {
    background: var(--color-gold-600);
    color: white;
  }

  .contact-actions .contact-action--primary:hover {
    background: color-mix(in srgb, var(--color-gold-600) 90%, var(--color-navy-950));
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }

    .contact-card {
      max-width: none;
      margin-top: .75rem;
    }
  }

  @media (min-width: 1024px) {
    .contact-card {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
</style>
