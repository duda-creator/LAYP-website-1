---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import contactPhoto from '../assets/images/Contact Us Karolina Gwinner.jpg';
import messagePhoto from '../assets/images/Focused Professional at Work.png';
import ContactForm from '../components/ContactForm.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PeakAccent from '../components/PeakAccent.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="Contact | Lead At Your Peak"
  description="Get in touch or book a discovery call to explore leadership development training, executive coaching, and bespoke programmes for your organisation."
>
  <Header slot="header" />

  <main>
    <!-- Hero -->
    <Section bg="navy" class="relative overflow-hidden">
      <PeakAccent variant="watermark" class="absolute -right-10 bottom-0 h-64 w-auto opacity-25" />
      <Container class="relative max-w-3xl text-center">
        <p class="eyebrow eyebrow--on-dark">Contact</p>
        <h1 class="mt-4 text-4xl md:text-5xl">Let's Start Your Ascent</h1>
        <div class="mt-6 flex justify-center"><PeakAccent /></div>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
          Whether you’re looking to elevate your own leadership or strengthen presence and performance across your organisation, reach out to explore what’s possible.
        </p>
      </Container>
    </Section>

    <!-- Form + contact details -->
    <Section bg="cream" id="message">
      <Container>
        <div class="contact-layout grid gap-12 lg:grid-cols-[1.4fr_1fr]">
          <FadeIn class="contact-message-panel">
            <section class="message-intro" aria-labelledby="message-heading">
              <Image
                src={messagePhoto}
                alt="Professional working on a laptop in a bright office"
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1280px) 635px, (min-width: 1024px) 55vw, 100vw"
                class="message-intro-photo"
                loading="lazy"
              />
              <div class="message-intro-shade" aria-hidden="true"></div>
              <div class="message-intro-content">
                <h2 id="message-heading">Send Us a Message</h2>
                <span class="mt-5 block h-0.5 w-10 rounded-full bg-gold-600" aria-hidden="true"></span>
                <div class="message-intro-body">
                  <p>Have a question or an idea you'd like to explore? We'd love to hear from you.</p>
                  <p>Please complete the form below,<br />and we'll be in touch soon.</p>
                </div>
                <p class="message-response-note">
                  <Icon name="clock" class="h-5 w-5 shrink-0 text-gold-600" />
                  <span>We typically respond within 1 business day.</span>
                </p>
              </div>
            </section>
          </FadeIn>

          <FadeIn delay={150} class="contact-talk-panel mx-auto w-full max-w-md lg:mx-0">
            <article class="contact-tile" aria-labelledby="talk-heading">
              <div class="contact-tile-hero">
                <Image
                  src={contactPhoto}
                  alt="Karolina Gwinner smiling during a coaching conversation"
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 1024px) 320px, 70vw"
                  class="contact-tile-photo"
                  loading="lazy"
                />
                <div class="contact-tile-copy">
                  <h2 id="talk-heading">Prefer to talk<br />it through?</h2>
                  <span class="contact-tile-accent" aria-hidden="true"></span>
                  <p>Let's explore your goals and how I can support you and your organisation.</p>
                </div>
              </div>

            </article>
          </FadeIn>

          <FadeIn class="contact-form-panel">
            <div class="pt-8">
              <ContactForm />
            </div>
          </FadeIn>

          <FadeIn delay={150} class="contact-actions-panel mx-auto w-full max-w-md lg:mx-0">
              <section id="book" class="contact-consultation" aria-labelledby="consultation-heading">
                <span class="contact-tile-icon consultation-icon">
                  <Icon name="calendar" class="h-8 w-8" />
                </span>
                <h3 id="consultation-heading">Start the Conversation</h3>
                <p>A focused conversation to explore your goals, needs and what's possible.</p>
                <a href="https://zcal.co/karolinagwinner" target="_blank" rel="noopener noreferrer" class="contact-tile-button">
                  <span>Schedule a Call</span>
                  <Icon name="arrow-right" class="h-5 w-5 shrink-0" />
                </a>
                <PeakAccent variant="watermark" class="consultation-peak absolute -right-2 bottom-0 h-14 w-auto opacity-20" />
              </section>

            <section class="mt-6 rounded-2xl bg-white p-5 text-navy-900 ring-1 ring-navy-900/10" aria-labelledby="connect-now-heading">
              <Icon name="message-circle" class="h-5 w-5 text-gold-600" />
              <h3 id="connect-now-heading" class="mt-4 font-body text-lg font-semibold leading-snug text-navy-900">Prefer to Connect Now?</h3>
              <p class="mt-4 text-base leading-relaxed text-navy-900/85">Have a question or something you'd like to explore? Reach out directly.</p>
              <a href="tel:+6592330165" class="mt-4 inline-flex min-h-8 items-center gap-3 text-lg font-semibold text-navy-900 transition-colors hover:text-gold-600">
                <Icon name="phone" class="h-4 w-4 shrink-0 text-gold-600" />
                <span>+65 9233 0165</span>
              </a>
              <a href="https://wa.me/6592330165" target="_blank" rel="noopener noreferrer" class="mt-4 flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-3 text-center text-base font-semibold leading-snug text-navy-900 transition-colors hover:bg-navy-100">
                <Icon name="message-circle" class="h-5 w-5 shrink-0" />
                <span>Message on WhatsApp</span>
                <Icon name="arrow-right" class="h-4 w-4 shrink-0" />
              </a>
            </section>
          </FadeIn>
        </div>
      </Container>
    </Section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-layout {
    grid-template-areas: 'message' 'form' 'talk' 'actions';
    row-gap: 0;
  }

  .contact-layout > :global(.contact-message-panel) {
    display: grid;
    grid-area: message;
    min-width: 0;
  }

  .contact-layout > :global(.contact-talk-panel) {
    display: grid;
    grid-area: talk;
    min-width: 0;
    margin-top: 3rem;
  }

  .contact-layout > :global(.contact-form-panel) {
    grid-area: form;
    min-width: 0;
  }

  .contact-layout > :global(.contact-actions-panel) {
    grid-area: actions;
    min-width: 0;
  }

  .message-intro {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 75%);
    border-radius: 1.5rem;
    background: var(--color-cream);
    box-shadow: 0 16px 40px rgb(13 33 56 / 9%);
  }

  .message-intro-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--color-cream) 32%, rgb(246 245 242 / 98%) 46%, rgb(246 245 242 / 80%) 55%, rgb(246 245 242 / 20%) 66%, transparent 75%);
  }

  .message-intro-photo {
    position: absolute;
    inset: 0 -11% 0 auto;
    width: 92%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }

  .message-intro-content {
    position: relative;
    z-index: 2;
    width: 65%;
    min-height: 21rem;
    padding: 3rem clamp(1.5rem, 4.5cqi, 2rem);
    text-align: left;
  }

  .message-intro-content h2 {
    color: var(--color-navy-950);
    font-size: clamp(1.5rem, 4.8cqi, 2rem);
    line-height: 1.2;
    letter-spacing: -.035em;
  }

  .message-intro-body {
    margin-top: 1.5rem;
    color: var(--color-navy-950);
    font-size: clamp(.9375rem, 2.6cqi, 1.0625rem);
    line-height: 1.6;
  }

  .message-intro-body p + p {
    margin-top: 1.25rem;
  }

  .message-response-note {
    display: inline-flex;
    align-items: center;
    gap: .625rem;
    margin-top: 1.75rem;
    padding: .625rem .875rem;
    border: 1px solid rgb(185 137 71 / 40%);
    border-radius: 999px;
    background: rgb(246 245 242 / 85%);
    color: var(--color-navy-950);
    font-size: .8125rem;
    font-weight: 700;
    line-height: 1.5;
  }

  @container (max-width: 28rem) {
    .message-intro-photo {
      position: relative;
      inset: auto;
      width: 100%;
      height: 14rem;
      object-position: 65% 35%;
    }

    .message-intro-shade {
      bottom: auto;
      height: 14rem;
      background: linear-gradient(180deg, transparent 65%, var(--color-cream));
    }

    .message-intro-content {
      width: 100%;
      min-height: 0;
      padding: 1.5rem 1.25rem 2rem;
    }
  }

  .contact-tile {
    display: grid;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 1rem 1rem 0 0;
    background: var(--color-navy-900);
    box-shadow: 0 12px 32px rgb(13 33 56 / 12%);
  }

  .contact-tile-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(18rem, 65cqi, 22rem);
    overflow: hidden;
    background: var(--color-cream);
  }

  .contact-tile-hero::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
    background: linear-gradient(90deg, var(--color-cream) 25%, rgb(246 245 242 / 95%) 36%, rgb(246 245 242 / 50%) 49%, transparent 65%);
  }

  .contact-tile-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: 70%;
    height: 100%;
    object-fit: cover;
    object-position: 61% top;
  }

  .contact-tile-copy {
    position: relative;
    z-index: 3;
    width: 60%;
    padding: 2rem clamp(1.25rem, 6cqi, 1.75rem);
    padding-right: 0;
  }

  .contact-tile-accent {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 1.25rem;
    background: var(--color-gold-600);
  }

  .contact-tile-copy h2 {
    font-size: clamp(1.3rem, 6cqi, 1.75rem);
    line-height: 1.2;
    letter-spacing: -.035em;
    color: var(--color-navy-950);
  }

  .contact-tile-copy p {
    max-width: 10.5rem;
    margin-top: 1.5rem;
    font-size: clamp(.8125rem, 3.5cqi, .9375rem);
    line-height: 1.5;
    color: var(--color-navy-950);
  }

  .contact-consultation {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 8cqi, 2.25rem);
    color: white;
    background: linear-gradient(135deg, var(--color-navy-800), var(--color-navy-950));
    border-radius: 0 0 1rem 1rem;
    box-shadow: 0 12px 32px rgb(13 33 56 / 12%);
  }

  .contact-consultation .consultation-icon {
    width: 3.25rem;
    height: 3.25rem;
  }

  .contact-consultation h3 {
    margin-top: 1rem;
    color: white;
    font-size: clamp(1.5rem, 7cqi, 2rem);
    line-height: 1.15;
  }

  .contact-consultation > p {
    max-width: 17rem;
    margin-top: .75rem;
    color: rgb(255 255 255 / 90%);
    font-size: clamp(1rem, 4.2cqi, 1.125rem);
    line-height: 1.5;
  }

  .contact-tile-icon {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-gold-400);
    background: rgb(232 216 182 / 20%);
  }

  .contact-tile-button {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 20rem;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: .625rem;
    margin-top: 1.5rem;
    padding: .75rem 1rem;
    border-radius: 999px;
    background: linear-gradient(110deg, var(--color-gold-200), var(--color-gold-400));
    color: var(--color-navy-950);
    font-family: var(--font-heading);
    font-size: clamp(.75rem, 3.5cqi, .9375rem);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    transition: filter .2s;
  }

  .contact-tile-button:hover {
    filter: brightness(.94);
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-areas: 'message talk' 'form actions';
      grid-template-rows: auto auto;
    }

    .contact-layout > :global(.contact-talk-panel) {
      margin-top: 0;
    }

    .contact-tile-copy {
      padding-block: 3rem;
    }
  }

</style>
