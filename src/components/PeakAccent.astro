---
import { Image } from 'astro:assets';
import laypSymbol from '../assets/images/layp-symbol.svg';

/**
 * The signature brand motif: the LAYP mountain mark, resized per placement.
 *
 * - underline: small flourish under a heading
 * - divider: full-width gradient rule between content blocks
 * - watermark: large, faint background mark for section corners
 */
interface Props {
  variant?: 'underline' | 'divider' | 'watermark';
  class?: string;
}

const { variant = 'underline', class: className = '' } = Astro.props;
const uid = `pg-${Math.random().toString(36).slice(2, 8)}`;
---

{
  variant === 'underline' && <Image src={laypSymbol} alt="" class:list={['h-6 w-auto', className]} />
}

{
  variant === 'divider' && (
    <svg
      viewBox="0 0 1200 24"
      fill="none"
      preserveAspectRatio="none"
      aria-hidden="true"
      class:list={['h-4 w-full', className]}
    >
      <defs>
        <linearGradient id={uid} x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="var(--color-gold-600)" stop-opacity="0" />
          <stop offset="0.3" stop-color="var(--color-gold-600)" />
          <stop offset="0.7" stop-color="var(--color-gold-200)" />
          <stop offset="1" stop-color="var(--color-gold-200)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path
        d="M0 20 216 10 420 13 600 6 780 12 984 10 1200 20"
        stroke={`url(#${uid})`}
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
  )
}

{
  variant === 'watermark' && (
    <Image src={laypSymbol} alt="" class:list={['pointer-events-none select-none', className]} />
  )
}
