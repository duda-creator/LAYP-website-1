---
import Button from './Button.astro';

interface Props {
  /** Lighter status-message colours for use on dark surfaces */
  onDark?: boolean;
}

const { onDark = false } = Astro.props;

const field =
  'w-full rounded-lg border border-navy-800/20 bg-white px-4 py-3 text-base text-ink placeholder:text-ink/40 transition focus:border-navy-600 focus:outline-none focus:ring-2 focus:ring-navy-600/25';
---

<form
  data-w3form
  data-success-message="You're in! Look out for your first edition."
  data-error-message="Subscription failed. Please try again."
  data-status-on-dark={onDark ? '' : undefined}
  novalidate
  class="mx-auto max-w-2xl"
>
  <input type="hidden" name="access_key" value="13507d48-81e6-4c6a-9906-658724b6078c" />
  <input type="hidden" name="subject" value="New newsletter subscriber — leadatyourpeak.com" />
  <input type="hidden" name="from_name" value="Lead At Your Peak website" />
  <!-- Honeypot — hidden from humans, tempting for bots -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-3 sm:grid-cols-[1fr_1fr_1.4fr_auto]">
    <div>
      <label for="newsletter-first-name" class="sr-only">First name</label>
      <input
        id="newsletter-first-name"
        name="first_name"
        type="text"
        required
        autocomplete="given-name"
        placeholder="First name"
        class={field}
      />
    </div>
    <div>
      <label for="newsletter-second-name" class="sr-only">Second name</label>
      <input
        id="newsletter-second-name"
        name="second_name"
        type="text"
        required
        autocomplete="family-name"
        placeholder="Second name"
        class={field}
      />
    </div>
    <div>
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="Email address"
        class={field}
      />
    </div>
    <Button type="submit">Subscribe</Button>
  </div>

  <!-- Invisible hCaptcha — only challenges suspicious traffic, verified server-side by Web3Forms -->
  <div class="h-captcha" data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2" data-size="invisible"></div>

  <p data-form-status class="mt-3 hidden text-sm font-medium" role="status" aria-live="polite"></p>
</form>

<script>
  import '../scripts/web3forms';
</script>
