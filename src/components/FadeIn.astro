---
/**
 * Fades children in as they enter the viewport.
 * Styling lives in global.css and is disabled under prefers-reduced-motion.
 */
interface Props {
  class?: string;
  /** Stagger delay in ms for grouped items. */
  delay?: number;
}

const { class: className = '', delay = 0 } = Astro.props;
---

<div data-fade-in class={className} style={delay ? `transition-delay: ${delay}ms` : undefined}>
  <slot />
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('[data-fade-in]').forEach((el) => observer.observe(el));
</script>
