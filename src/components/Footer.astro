---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-small.png';
import Button from './Button.astro';
import Container from './Container.astro';
import Icon from './Icon.astro';
import PeakAccent from './PeakAccent.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];

const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/karolinagwinner/', target: '_blank', rel: 'noopener noreferrer' },
  { name: 'youtube', label: 'YouTube', href: 'https://www.youtube.com/@KarolinaGwinner', target: '_blank', rel: 'noopener noreferrer' },
  { name: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/kgwinner/', target: '_blank', rel: 'noopener noreferrer' },
] as const satisfies readonly {
  name: string;
  label: string;
  href: string;
  target: '_blank';
  rel: 'noopener noreferrer';
}[];

const year = new Date().getFullYear();
---

<footer class="bg-navy-800 text-white">
  <PeakAccent variant="divider" class="opacity-70" />
  <Container class="py-12 md:py-16">
    <div class="grid items-start gap-10 md:grid-cols-2 md:gap-x-12 lg:grid-cols-[repeat(4,max-content)] lg:justify-between lg:gap-x-8 xl:gap-x-12">
      <div>
        <a href="/" aria-label="Lead At Your Peak — home" class="inline-block overflow-hidden align-top">
          <!-- Offset the asset's inset so the artwork aligns with the headings and copyright. -->
          <Image src={logo} alt="Lead At Your Peak" class="-ml-[0.45rem] h-[3.6rem] w-auto md:-mt-1.5" densities={[1, 2]} />
        </a>
        <p class="mt-5 max-w-[17rem] text-[14px] leading-[1.6] text-white/85">
          We are a Singapore-based leadership development consultancy working with leaders and teams worldwide.
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="eyebrow eyebrow--on-dark">Explore</p>
        <ul class="mt-4 space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-[15px] font-medium leading-5 text-white/85 transition-colors duration-250 ease-out hover:text-[#CBB26B]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="eyebrow eyebrow--on-dark">Contact us</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/contact#message" variant="outline-light" class="min-h-11 px-5 py-2.5 text-sm text-gold-600 hover:text-gold-400">
            Send us a message
          </Button>
        </div>
      </div>

      <div>
        <p class="eyebrow eyebrow--on-dark">Follow us</p>
        <ul class="relative -left-2.5 mt-4 flex gap-1" aria-label="Social media">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.target}
                  rel={social.rel}
                  aria-label={social.label}
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full transition hover:bg-white/5 hover:text-gold-400"
                >
                  <Icon name={social.name} class="h-6 w-6" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/15 pt-6">
      <p class="text-xs text-white/60">&copy; {year} Charismatic Leaders Pte. Ltd. All rights reserved.</p>
    </div>
  </Container>
</footer>
